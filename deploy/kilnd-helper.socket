[Unit]
Description=Private kilnd privilege-helper socket
# Nothing activates while an interrupted maintenance command is unfinished.
Requires=kilnd-maintenance-guard.service
After=systemd-tmpfiles-setup.service kilnd-maintenance-guard.service

[Socket]
ListenStream=/run/kilnd-helper/helper.sock
SocketUser=root
SocketGroup=kilnd-helper
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=yes
Backlog=64

[Install]
WantedBy=sockets.target
