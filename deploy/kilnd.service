[Unit]
Description=Unprivileged kilnd sandbox control daemon
Documentation=https://github.com/lambda-nine/kilnd
Requires=kilnd-helper.socket
After=kilnd-helper.socket kilnd-helper.service
Wants=kilnd-helper.service

[Service]
User=kilnd
Group=kilnd
ExecStart=/usr/local/bin/kilnd --helper-socket /run/kilnd-helper/helper.sock --log-format json
# Preserve legacy shims started by the old root daemon during upgrades.
# Fresh deployments put all new shims in the helper service.
KillMode=process
TimeoutStopSec=300
Restart=on-failure
RestartSec=2
StateDirectory=kilnd
StateDirectoryMode=0700
RuntimeDirectory=kilnd
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
InaccessiblePaths=-/var/lib/kiln -/run/kiln

[Install]
WantedBy=multi-user.target
