[Unit]
Description=kilnd sandbox control daemon (gRPC on /run/kilnd/kilnd.sock)
Documentation=https://github.com/lambda-nine/kilnd
After=network-online.target kiln-dns.service
Wants=network-online.target kiln-dns.service

[Service]
# One JSON object per line; read with journalctl -u kilnd -o cat.
ExecStart=/usr/local/bin/kilnd --kiln /usr/local/bin/kiln --log-format json
# kiln create starts each sandbox's shim from kilnd's cgroup. Stopping or
# restarting kilnd must not kill them: sandboxes outlive the daemon, and
# startup reconciliation adopts them again. Only the main process is
# signaled; kilnd itself stops its kiln exec clients.
KillMode=process
# Covers --shutdown-grace-secs, the final RPC wait, and the longest accepted
# create plus failed-publication compensation before systemd forces a stop.
TimeoutStopSec=300
Restart=on-failure
RestartSec=2
StateDirectory=kilnd
StateDirectoryMode=0700
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
