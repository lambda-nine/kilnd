[Unit]
Description=Minimal privileged kiln operations for kilnd
Requires=kilnd-helper.socket
After=kilnd-helper.socket kiln-dns.service
Wants=kiln-dns.service

[Service]
ExecStart=/usr/local/bin/kilnd-helper
User=root
Group=kilnd
Sockets=kilnd-helper.socket
# Detached sandbox shims must outlive helper restart. CLI clients use PDEATHSIG.
KillMode=process
TimeoutStopSec=300
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/proc/sys /sys /dev
InaccessiblePaths=-/dev/kmsg -/proc/kmsg
ReadWritePaths=/var/lib/kiln /run/kiln /sys/fs/cgroup /proc/sys/net/ipv4/ip_forward
# Namespace/mount setup, network policy, UID maps, quota setup and cleanup.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL
# With explicit User=root, systemd's seccomp credential transition otherwise
# drops effective CAP_SETUID; retain it for kiln's UID-map setup.
AmbientCapabilities=CAP_SETUID
# Control/stdio, network setup, and libc hostname resolution for allowlists.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
LockPersonality=yes
RestrictRealtime=yes
ProtectKernelLogs=yes
# Namespace creation, syscall policy and privilege dropping are kiln's job.
# Do not use PrivateNetwork/ProtectControlGroups/RestrictNamespaces here.

[Install]
WantedBy=multi-user.target
