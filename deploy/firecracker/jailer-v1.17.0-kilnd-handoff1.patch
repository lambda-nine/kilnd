diff --git a/src/jailer/src/handoff.rs b/src/jailer/src/handoff.rs
new file mode 100644
index 0000000..8538b00
--- /dev/null
+++ b/src/jailer/src/handoff.rs
@@ -0,0 +1,1078 @@
+// Copyright 2026 Estrada Systems LLC. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! kilnd handoff (`kilnd-handoff1`): descriptor handoff, bootstrap gate and capability drop.
+//!
+//! The supervisor (S) execs this jailer (J) by descriptor with exactly FD 3 (read-only,
+//! verified Firecracker executable) and FD 4 (AF_UNIX stream socket to S) beyond stdio. J
+//! reads a canonical bootstrap record from FD 4, proves FD 3 and the jail root are the
+//! exact objects S pinned, answers `RDY1` and waits for `CONT` before any setup. The VMM
+//! child (V) drops every privilege, verifies the result and execs FD 3 with `execveat`.
+//! There is no pathname exec, no copy of the executable and no fallback.
+//!
+//! Exit codes: 70 bootstrap refusal (before any setup), 71 V failed to drop or verify
+//! privileges (no exec), 72 `execveat` returned.
+
+use std::ffi::CString;
+use std::fmt::Display;
+use std::os::unix::ffi::OsStrExt;
+use std::os::unix::fs::MetadataExt;
+use std::path::{Component, Path, PathBuf};
+
+use serde::{Deserialize, Serialize};
+use utils::arg_parser::Arguments;
+use utils::validators;
+
+/// The verified VMM executable, read-only.
+pub const VMM_FD: libc::c_int = 3;
+/// The AF_UNIX stream control socket to S.
+pub const CONTROL_FD: libc::c_int = 4;
+/// First descriptor closed at entry.
+const FIRST_CLOSED_FD: libc::c_uint = 5;
+
+pub const EXIT_BOOTSTRAP: i32 = 70;
+pub const EXIT_PRIVILEGE_DROP: i32 = 71;
+pub const EXIT_EXEC: i32 = 72;
+
+pub const MAX_RECORD_BYTES: usize = 4096;
+const READY: &[u8; 4] = b"RDY1";
+const CONTINUE: &[u8; 4] = b"CONT";
+
+/// Bootstrap record. Fields are declared in alphabetical order so that serde_json's
+/// serialization is the canonical (sorted-key, no whitespace) encoding.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct BootstrapRecord {
+    pub exec_file_label: String,
+    pub jail_root_identity: JailRootIdentity,
+    pub plan_generation: u64,
+    pub version: u32,
+    pub vmm_identity: VmmIdentity,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct JailRootIdentity {
+    pub mount_id: u64,
+    pub st_dev: u64,
+    pub st_ino: u64,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct VmmIdentity {
+    pub bytes: u64,
+    pub sha256: String,
+    pub st_dev: u64,
+    pub st_ino: u64,
+}
+
+/// Paths derived from the contract argv without touching the filesystem.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ContractPaths {
+    pub exec_file_label: String,
+    pub exec_file_name: String,
+    pub chroot_dir: PathBuf,
+}
+
+/// Refuses the bootstrap: one line on stderr, exit 70, no setup.
+#[allow(clippy::exit)] // A refusal ends J before any setup; nothing needs unwinding.
+pub fn refuse(message: impl Display) -> ! {
+    eprintln!("jailer: kilnd bootstrap refused: {message}");
+    std::process::exit(EXIT_BOOTSTRAP)
+}
+
+fn errno() -> i32 {
+    std::io::Error::last_os_error().raw_os_error().unwrap_or(0)
+}
+
+fn os_error(what: &str) -> String {
+    format!("{what}: {}", std::io::Error::last_os_error())
+}
+
+// ---------------------------------------------------------------------------------------
+// Step 1: descriptor sanitization.
+
+/// Closes every inherited descriptor from 5 upwards (replaces upstream's close of 3..MAX).
+pub fn close_inherited_fds() -> Result<(), String> {
+    // SAFETY: closing a descriptor range this process owns.
+    let rc = unsafe {
+        libc::syscall(
+            libc::SYS_close_range,
+            FIRST_CLOSED_FD,
+            libc::c_uint::MAX,
+            0 as libc::c_uint,
+        )
+    };
+    if rc != 0 {
+        return Err(os_error("close_range(5, UINT_MAX)"));
+    }
+    Ok(())
+}
+
+/// FD 3 must be a regular file opened O_RDONLY, FD 4 an AF_UNIX SOCK_STREAM socket. Both
+/// then become close-on-exec, so neither can survive into Firecracker.
+pub fn check_bootstrap_fds() -> Result<(), String> {
+    // SAFETY: querying a descriptor; a closed one reports EBADF.
+    let flags = unsafe { libc::fcntl(VMM_FD, libc::F_GETFL) };
+    if flags < 0 {
+        return Err(os_error("FD 3"));
+    }
+    if flags & libc::O_PATH != 0 || flags & libc::O_ACCMODE != libc::O_RDONLY {
+        return Err("FD 3 is not opened O_RDONLY".into());
+    }
+    let stat = fstat(VMM_FD).map_err(|e| format!("FD 3: {e}"))?;
+    if stat.st_mode & libc::S_IFMT != libc::S_IFREG {
+        return Err("FD 3 is not a regular file".into());
+    }
+    if sockopt_int(CONTROL_FD, libc::SO_TYPE)? != libc::SOCK_STREAM {
+        return Err("FD 4 is not a SOCK_STREAM socket".into());
+    }
+    if sockopt_int(CONTROL_FD, libc::SO_DOMAIN)? != libc::AF_UNIX {
+        return Err("FD 4 is not an AF_UNIX socket".into());
+    }
+    for fd in [VMM_FD, CONTROL_FD] {
+        // SAFETY: setting descriptor flags on a live descriptor.
+        if unsafe { libc::fcntl(fd, libc::F_SETFD, libc::FD_CLOEXEC) } != 0 {
+            return Err(os_error(&format!("FD {fd} FD_CLOEXEC")));
+        }
+    }
+    Ok(())
+}
+
+fn sockopt_int(fd: libc::c_int, option: libc::c_int) -> Result<libc::c_int, String> {
+    let mut value: libc::c_int = 0;
+    let mut length: libc::socklen_t = 4; // sizeof(int)
+    // SAFETY: the output pointers are live and sized for an int option.
+    let rc = unsafe {
+        libc::getsockopt(
+            fd,
+            libc::SOL_SOCKET,
+            option,
+            (&mut value as *mut libc::c_int).cast(),
+            &mut length,
+        )
+    };
+    if rc != 0 {
+        return Err(os_error(&format!("FD {fd} is not a socket")));
+    }
+    Ok(value)
+}
+
+fn fstat(fd: libc::c_int) -> Result<libc::stat, String> {
+    // SAFETY: zeroed stat is valid storage for fstat to fill.
+    let mut stat: libc::stat = unsafe { std::mem::zeroed() };
+    // SAFETY: stat is live storage.
+    if unsafe { libc::fstat(fd, &mut stat) } != 0 {
+        return Err(os_error("fstat"));
+    }
+    Ok(stat)
+}
+
+// ---------------------------------------------------------------------------------------
+// Contract argv.
+
+/// The `--exec-file` value is only a label: an absolute UTF-8 path with no `.`, `..` or
+/// empty components. Returns its basename. Never touches the filesystem.
+pub fn exec_file_basename(label: &str) -> Result<String, String> {
+    let rest = label
+        .strip_prefix('/')
+        .ok_or_else(|| format!("--exec-file {label:?} is not absolute"))?;
+    let parts: Vec<&str> = rest.split('/').collect();
+    if parts
+        .iter()
+        .any(|part| part.is_empty() || *part == "." || *part == "..")
+    {
+        return Err(format!(
+            "--exec-file {label:?} has an empty, '.' or '..' component"
+        ));
+    }
+    // `rest` is non-empty here ("/" alone yields one empty component).
+    Ok(parts[parts.len() - 1].to_string())
+}
+
+/// `<chroot-base-dir>/<exec-file basename>/<id>/root`, lexically, without canonicalization.
+pub fn contract_chroot_dir(
+    chroot_base: &str,
+    exec_file_name: &str,
+    id: &str,
+) -> Result<PathBuf, String> {
+    let base = Path::new(chroot_base);
+    if !base.is_absolute()
+        || base
+            .components()
+            .any(|c| matches!(c, Component::CurDir | Component::ParentDir))
+    {
+        return Err(format!(
+            "--chroot-base-dir {chroot_base:?} must be absolute without '.' or '..'"
+        ));
+    }
+    validators::validate_instance_id(id).map_err(|e| format!("--id: {e}"))?;
+    Ok(base.join(exec_file_name).join(id).join("root"))
+}
+
+/// Refuses every option the kilnd contract never uses and derives the paths.
+pub fn contract_paths(arguments: &Arguments) -> Result<ContractPaths, String> {
+    if arguments.flag_present("daemonize") {
+        return Err("--daemonize is not part of the kilnd contract".into());
+    }
+    if arguments.single_value("netns").is_some() {
+        return Err("--netns is not part of the kilnd contract".into());
+    }
+    if arguments.multiple_values("cgroup").is_some() {
+        return Err("--cgroup is not part of the kilnd contract".into());
+    }
+    if !arguments.flag_present("new-pid-ns") {
+        return Err("--new-pid-ns is required by the kilnd contract".into());
+    }
+    let id = arguments.single_value("id").ok_or("--id is missing")?;
+    let label = arguments
+        .single_value("exec-file")
+        .ok_or("--exec-file is missing")?;
+    let chroot_base = arguments
+        .single_value("chroot-base-dir")
+        .ok_or("--chroot-base-dir is missing")?;
+    let exec_file_name = exec_file_basename(label)?;
+    let chroot_dir = contract_chroot_dir(chroot_base, &exec_file_name, id)?;
+    Ok(ContractPaths {
+        exec_file_label: label.clone(),
+        exec_file_name,
+        chroot_dir,
+    })
+}
+
+// ---------------------------------------------------------------------------------------
+// Step 2: bootstrap record.
+
+fn read_exact_fd(fd: libc::c_int, buf: &mut [u8]) -> Result<(), String> {
+    let mut done = 0;
+    while done < buf.len() {
+        // SAFETY: the destination is the live unfilled tail of `buf`.
+        let n = unsafe { libc::read(fd, buf[done..].as_mut_ptr().cast(), buf.len() - done) };
+        if n < 0 {
+            if errno() == libc::EINTR {
+                continue;
+            }
+            return Err(os_error("read FD 4"));
+        }
+        if n == 0 {
+            return Err(format!("EOF on FD 4 after {done} of {} bytes", buf.len()));
+        }
+        done += n.unsigned_abs();
+    }
+    Ok(())
+}
+
+fn write_all_fd(fd: libc::c_int, buf: &[u8]) -> Result<(), String> {
+    let mut done = 0;
+    while done < buf.len() {
+        // SAFETY: the source is the live unsent tail of `buf`; MSG_NOSIGNAL avoids SIGPIPE.
+        let n = unsafe {
+            libc::send(
+                fd,
+                buf[done..].as_ptr().cast(),
+                buf.len() - done,
+                libc::MSG_NOSIGNAL,
+            )
+        };
+        if n < 0 {
+            if errno() == libc::EINTR {
+                continue;
+            }
+            return Err(os_error("write FD 4"));
+        }
+        done += n.unsigned_abs();
+    }
+    Ok(())
+}
+
+/// Parses and canonically checks a record.
+pub fn parse_record(raw: &[u8]) -> Result<BootstrapRecord, String> {
+    if raw.is_empty() || raw.len() > MAX_RECORD_BYTES {
+        return Err(format!("record length {} out of range", raw.len()));
+    }
+    let record: BootstrapRecord =
+        serde_json::from_slice(raw).map_err(|e| format!("record: {e}"))?;
+    let canonical = serde_json::to_vec(&record).map_err(|e| format!("record: {e}"))?;
+    if canonical != raw {
+        return Err("record is not canonical".into());
+    }
+    if record.version != 1 {
+        return Err(format!("record version {} is not 1", record.version));
+    }
+    let digest = record.vmm_identity.sha256.as_bytes();
+    if digest.len() != 64
+        || !digest
+            .iter()
+            .all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f'))
+    {
+        return Err("vmm_identity.sha256 is not 64 lowercase hex digits".into());
+    }
+    Ok(record)
+}
+
+/// Reads `u32` big-endian length L (1..=4096) then exactly L bytes from `fd`.
+pub fn read_record(fd: libc::c_int) -> Result<BootstrapRecord, String> {
+    let mut length = [0u8; 4];
+    read_exact_fd(fd, &mut length)?;
+    let length = u32::from_be_bytes(length) as usize;
+    if length == 0 || length > MAX_RECORD_BYTES {
+        return Err(format!("record length {length} out of range"));
+    }
+    let mut raw = vec![0u8; length];
+    read_exact_fd(fd, &mut raw)?;
+    parse_record(&raw)
+}
+
+// ---------------------------------------------------------------------------------------
+// Step 3: validation.
+
+/// The kernel's `struct statx` (256 bytes), defined locally so the musl target needs no
+/// libc binding.
+#[repr(C)]
+#[derive(Debug)]
+struct Statx {
+    stx_mask: u32,
+    stx_blksize: u32,
+    stx_attributes: u64,
+    stx_nlink: u32,
+    stx_uid: u32,
+    stx_gid: u32,
+    stx_mode: u16,
+    spare0: u16,
+    stx_ino: u64,
+    stx_size: u64,
+    stx_blocks: u64,
+    stx_attributes_mask: u64,
+    stx_times: [[u64; 2]; 4],
+    stx_rdev_major: u32,
+    stx_rdev_minor: u32,
+    stx_dev_major: u32,
+    stx_dev_minor: u32,
+    stx_mnt_id: u64,
+    spare: [u64; 13],
+}
+
+const STATX_INO: u32 = 0x100;
+const STATX_MNT_ID: u32 = 0x1000;
+
+fn statx_nofollow(path: &Path) -> Result<Statx, String> {
+    let c_path = CString::new(path.as_os_str().as_bytes()).map_err(|e| e.to_string())?;
+    // SAFETY: an all-zero statx is valid storage.
+    let mut stx: Statx = unsafe { std::mem::zeroed() };
+    // SAFETY: path is NUL-terminated and stx is 256 bytes of live storage.
+    let rc = unsafe {
+        libc::syscall(
+            libc::SYS_statx,
+            libc::AT_FDCWD,
+            c_path.as_ptr(),
+            libc::AT_SYMLINK_NOFOLLOW,
+            STATX_INO | STATX_MNT_ID,
+            &mut stx as *mut Statx,
+        )
+    };
+    if rc != 0 {
+        return Err(os_error(&format!("statx {}", path.display())));
+    }
+    if stx.stx_mask & (STATX_INO | STATX_MNT_ID) != (STATX_INO | STATX_MNT_ID) {
+        return Err(format!(
+            "statx {} lacks STATX_INO|STATX_MNT_ID",
+            path.display()
+        ));
+    }
+    Ok(stx)
+}
+
+/// SHA-256 of FD's first `bytes` bytes via `pread` from offset 0; the descriptor's own
+/// offset is never used. Requires EOF exactly at `bytes`.
+fn sha256_fd(fd: libc::c_int, bytes: u64) -> Result<String, String> {
+    let mut hasher = Sha256::new();
+    let mut buf = vec![0u8; 1 << 16];
+    let mut offset: u64 = 0;
+    loop {
+        let position =
+            libc::off_t::try_from(offset).map_err(|_| "FD 3 offset overflow".to_string())?;
+        // SAFETY: buf is live storage of the given length.
+        let n = unsafe { libc::pread(fd, buf.as_mut_ptr().cast(), buf.len(), position) };
+        if n < 0 {
+            if errno() == libc::EINTR {
+                continue;
+            }
+            return Err(os_error("pread FD 3"));
+        }
+        if n == 0 {
+            break;
+        }
+        let n = n.unsigned_abs();
+        hasher.update(&buf[..n]);
+        offset += n as u64;
+        if offset > bytes {
+            return Err("FD 3 is longer than vmm_identity.bytes".into());
+        }
+    }
+    if offset != bytes {
+        return Err("FD 3 is shorter than vmm_identity.bytes".into());
+    }
+    Ok(hex(&hasher.finish()))
+}
+
+/// Proves FD 3, the label and the jail root match the record.
+pub fn validate(record: &BootstrapRecord, paths: &ContractPaths) -> Result<(), String> {
+    let vmm = &record.vmm_identity;
+    let stat = fstat(VMM_FD).map_err(|e| format!("FD 3: {e}"))?;
+    #[allow(clippy::unnecessary_cast)]
+    let (dev, ino) = (stat.st_dev as u64, stat.st_ino as u64);
+    let size = u64::try_from(stat.st_size).map_err(|_| "FD 3 has a negative size".to_string())?;
+    if stat.st_mode & libc::S_IFMT != libc::S_IFREG
+        || dev != vmm.st_dev
+        || ino != vmm.st_ino
+        || size != vmm.bytes
+    {
+        return Err("FD 3 dev/ino/size differ from vmm_identity".into());
+    }
+    if sha256_fd(VMM_FD, size)? != vmm.sha256 {
+        return Err("FD 3 SHA-256 differs from vmm_identity".into());
+    }
+    if record.exec_file_label.as_bytes() != paths.exec_file_label.as_bytes() {
+        return Err("exec_file_label differs from --exec-file".into());
+    }
+
+    let root = statx_nofollow(&paths.chroot_dir)?;
+    let root_dev = libc::makedev(root.stx_dev_major, root.stx_dev_minor) as u64;
+    let jail = &record.jail_root_identity;
+    if u32::from(root.stx_mode) & libc::S_IFMT != libc::S_IFDIR
+        || root_dev != jail.st_dev
+        || root.stx_ino != jail.st_ino
+        || root.stx_mnt_id != jail.mount_id
+    {
+        return Err(format!(
+            "jail root {} differs from jail_root_identity",
+            paths.chroot_dir.display()
+        ));
+    }
+
+    let exec_in_jail = paths.chroot_dir.join(&paths.exec_file_name);
+    let meta = std::fs::symlink_metadata(&exec_in_jail)
+        .map_err(|e| format!("{}: {e}", exec_in_jail.display()))?;
+    if !meta.file_type().is_file() || meta.dev() != dev || meta.ino() != ino {
+        return Err(format!(
+            "{} is not FD 3's regular file",
+            exec_in_jail.display()
+        ));
+    }
+    let c_path = CString::new(exec_in_jail.as_os_str().as_bytes()).map_err(|e| e.to_string())?;
+    // SAFETY: an all-zero statvfs is valid storage.
+    let mut vfs: libc::statvfs = unsafe { std::mem::zeroed() };
+    // SAFETY: path is NUL-terminated and vfs is live storage.
+    if unsafe { libc::statvfs(c_path.as_ptr(), &mut vfs) } != 0 {
+        return Err(os_error(&format!("statvfs {}", exec_in_jail.display())));
+    }
+    if vfs.f_flag & libc::ST_RDONLY == 0 {
+        return Err(format!(
+            "{} is not on a read-only mount",
+            exec_in_jail.display()
+        ));
+    }
+    Ok(())
+}
+
+// ---------------------------------------------------------------------------------------
+// Step 4: gate.
+
+/// Writes `RDY1`, then requires exactly `CONT`.
+pub fn gate(fd: libc::c_int) -> Result<(), String> {
+    write_all_fd(fd, READY)?;
+    let mut answer = [0u8; 4];
+    read_exact_fd(fd, &mut answer)?;
+    if &answer != CONTINUE {
+        return Err(format!("gate answer {answer:?} is not CONT"));
+    }
+    Ok(())
+}
+
+/// Steps 1-4 in order. Any failure exits 70 before setup.
+pub fn bootstrap(arguments: &Arguments) {
+    if let Err(e) = check_bootstrap_fds() {
+        refuse(e);
+    }
+    let paths = contract_paths(arguments).unwrap_or_else(|e| refuse(e));
+    let record = read_record(CONTROL_FD).unwrap_or_else(|e| refuse(e));
+    if let Err(e) = validate(&record, &paths) {
+        refuse(e);
+    }
+    if let Err(e) = gate(CONTROL_FD) {
+        refuse(e);
+    }
+}
+
+// ---------------------------------------------------------------------------------------
+// Step 6: V's capability drop and descriptor exec.
+
+#[repr(C)]
+struct CapHeader {
+    version: u32,
+    pid: libc::c_int,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Default, PartialEq, Eq)]
+struct CapData {
+    effective: u32,
+    permitted: u32,
+    inheritable: u32,
+}
+
+const LINUX_CAPABILITY_VERSION_3: u32 = 0x2008_0522;
+const PR_CAP_AMBIENT: libc::c_int = 47;
+const PR_CAP_AMBIENT_IS_SET: libc::c_ulong = 1;
+const PR_CAP_AMBIENT_CLEAR_ALL: libc::c_ulong = 4;
+const PR_CAPBSET_READ: libc::c_int = 23;
+const PR_CAPBSET_DROP: libc::c_int = 24;
+const PR_SET_NO_NEW_PRIVS: libc::c_int = 38;
+const PR_GET_NO_NEW_PRIVS: libc::c_int = 39;
+const MAX_CAP: libc::c_ulong = 63;
+
+fn drop_fail(message: impl Display) -> ! {
+    eprintln!("jailer: kilnd privilege drop failed: {message}");
+    // SAFETY: _exit is always safe; no destructors or atexit handlers run.
+    unsafe { libc::_exit(EXIT_PRIVILEGE_DROP) }
+}
+
+fn capget() -> Result<[CapData; 2], String> {
+    let mut header = CapHeader {
+        version: LINUX_CAPABILITY_VERSION_3,
+        pid: 0,
+    };
+    let mut data = [CapData::default(); 2];
+    // SAFETY: header and two data words are live storage for version 3.
+    let rc = unsafe {
+        libc::syscall(
+            libc::SYS_capget,
+            &mut header as *mut CapHeader,
+            data.as_mut_ptr(),
+        )
+    };
+    if rc != 0 {
+        return Err(os_error("capget"));
+    }
+    Ok(data)
+}
+
+fn capset(data: &[CapData; 2]) -> Result<(), String> {
+    let mut header = CapHeader {
+        version: LINUX_CAPABILITY_VERSION_3,
+        pid: 0,
+    };
+    // SAFETY: header and two data words are live storage for version 3.
+    let rc = unsafe {
+        libc::syscall(
+            libc::SYS_capset,
+            &mut header as *mut CapHeader,
+            data.as_ptr(),
+        )
+    };
+    if rc != 0 {
+        return Err(os_error("capset"));
+    }
+    Ok(())
+}
+
+fn prctl(option: libc::c_int, a2: libc::c_ulong, a3: libc::c_ulong) -> libc::c_int {
+    // SAFETY: prctl with integer arguments only.
+    unsafe { libc::prctl(option, a2, a3, 0 as libc::c_ulong, 0 as libc::c_ulong) }
+}
+
+/// Walks 0..=63 with `probe`, which returns Ok(true) for "still set". Returns the first
+/// capability number the kernel rejects with EINVAL (one past its last capability).
+fn cap_walk(
+    what: &str,
+    mut probe: impl FnMut(libc::c_ulong) -> libc::c_int,
+    require_clear: bool,
+) -> Result<libc::c_ulong, String> {
+    for cap in 0..=MAX_CAP {
+        match probe(cap) {
+            0 => {}
+            1 if !require_clear => {}
+            -1 if errno() == libc::EINVAL => return Ok(cap),
+            -1 => return Err(os_error(&format!("{what} {cap}"))),
+            other => return Err(format!("{what} {cap} still set ({other})")),
+        }
+    }
+    Ok(MAX_CAP + 1)
+}
+
+fn raw_syscall_ok(rc: libc::c_long, what: &str) -> Result<(), String> {
+    if rc != 0 {
+        return Err(os_error(what));
+    }
+    Ok(())
+}
+
+/// The frozen `capability_drop_order`, steps 1-7.
+fn drop_privileges(uid: u32, gid: u32) -> Result<libc::c_ulong, String> {
+    // 1. Supplementary groups.
+    // SAFETY: an empty group list.
+    let rc = unsafe {
+        libc::syscall(
+            libc::SYS_setgroups,
+            0 as libc::size_t,
+            std::ptr::null::<libc::gid_t>(),
+        )
+    };
+    raw_syscall_ok(rc, "setgroups(0)")?;
+    // 2. Ambient set, then the inheritable set (effective/permitted kept for now).
+    if prctl(PR_CAP_AMBIENT, PR_CAP_AMBIENT_CLEAR_ALL, 0) != 0 {
+        return Err(os_error("PR_CAP_AMBIENT_CLEAR_ALL"));
+    }
+    let mut caps = capget()?;
+    for word in caps.iter_mut() {
+        word.inheritable = 0;
+    }
+    capset(&caps)?;
+    // 3. Every bounding bit, while still privileged.
+    let bounding_end = cap_walk(
+        "PR_CAPBSET_DROP",
+        |cap| prctl(PR_CAPBSET_DROP, cap, 0),
+        false,
+    )?;
+    if bounding_end == 0 {
+        return Err("kernel reports no capabilities".into());
+    }
+    // 4-5. GID then UID: real, effective and saved. Without SECBIT_KEEP_CAPS the kernel
+    // clears permitted and effective when every UID leaves 0.
+    // SAFETY: integer arguments only.
+    let rc = unsafe { libc::syscall(libc::SYS_setresgid, gid, gid, gid) };
+    raw_syscall_ok(rc, "setresgid")?;
+    // SAFETY: integer arguments only.
+    let rc = unsafe { libc::syscall(libc::SYS_setresuid, uid, uid, uid) };
+    raw_syscall_ok(rc, "setresuid")?;
+    // 6. All three sets explicitly zero.
+    capset(&[CapData::default(); 2])?;
+    // 7. no_new_privs.
+    if prctl(PR_SET_NO_NEW_PRIVS, 1, 0) != 0 {
+        return Err(os_error("PR_SET_NO_NEW_PRIVS"));
+    }
+    Ok(bounding_end)
+}
+
+/// Step 8: proves the drop before exec.
+fn verify_privileges(uid: u32, gid: u32, bounding_end: libc::c_ulong) -> Result<(), String> {
+    // SAFETY: size 0 only queries the count.
+    let groups = unsafe {
+        libc::syscall(
+            libc::SYS_getgroups,
+            0 as libc::c_int,
+            std::ptr::null_mut::<libc::gid_t>(),
+        )
+    };
+    if groups != 0 {
+        return Err(format!("getgroups reports {groups} groups"));
+    }
+    let (mut r, mut e, mut s): (libc::uid_t, libc::uid_t, libc::uid_t) = (0, 0, 0);
+    // SAFETY: three live output words.
+    let rc = unsafe {
+        libc::syscall(
+            libc::SYS_getresuid,
+            &mut r as *mut _,
+            &mut e as *mut _,
+            &mut s as *mut _,
+        )
+    };
+    raw_syscall_ok(rc, "getresuid")?;
+    if (r, e, s) != (uid, uid, uid) {
+        return Err(format!("resuid is {r}/{e}/{s}, not {uid}"));
+    }
+    let (mut r, mut e, mut s): (libc::gid_t, libc::gid_t, libc::gid_t) = (0, 0, 0);
+    // SAFETY: three live output words.
+    let rc = unsafe {
+        libc::syscall(
+            libc::SYS_getresgid,
+            &mut r as *mut _,
+            &mut e as *mut _,
+            &mut s as *mut _,
+        )
+    };
+    raw_syscall_ok(rc, "getresgid")?;
+    if (r, e, s) != (gid, gid, gid) {
+        return Err(format!("resgid is {r}/{e}/{s}, not {gid}"));
+    }
+    if capget()? != [CapData::default(); 2] {
+        return Err("effective/permitted/inheritable not all zero".into());
+    }
+    let read_end = cap_walk(
+        "PR_CAPBSET_READ",
+        |cap| prctl(PR_CAPBSET_READ, cap, 0),
+        true,
+    )?;
+    let ambient_end = cap_walk(
+        "PR_CAP_AMBIENT_IS_SET",
+        |cap| prctl(PR_CAP_AMBIENT, PR_CAP_AMBIENT_IS_SET, cap),
+        true,
+    )?;
+    if read_end != bounding_end || ambient_end != bounding_end {
+        return Err(format!(
+            "capability range differs: drop {bounding_end}, bounding {read_end}, ambient {ambient_end}"
+        ));
+    }
+    if prctl(PR_GET_NO_NEW_PRIVS, 0, 0) != 1 {
+        return Err("no_new_privs is not set".into());
+    }
+    Ok(())
+}
+
+/// V's whole tail: restore the default signal disposition and mask the way Rust's
+/// `Command::exec` did upstream, drop and verify every privilege (71 on any failure), then
+/// `execveat(3, "", argv, [], AT_EMPTY_PATH)`. 72 if it returns. No other exec exists.
+pub fn drop_privileges_and_exec(uid: u32, gid: u32, argv: &[String]) -> ! {
+    let argv: Vec<CString> = argv
+        .iter()
+        .map(|arg| CString::new(arg.as_bytes()))
+        .collect::<Result<_, _>>()
+        .unwrap_or_else(|e| drop_fail(format!("argv: {e}")));
+    let mut argv_ptrs: Vec<*const libc::c_char> = argv.iter().map(|a| a.as_ptr()).collect();
+    argv_ptrs.push(std::ptr::null());
+    let envp: [*const libc::c_char; 1] = [std::ptr::null()];
+
+    // Rust's std ignores SIGPIPE; Command::exec reset it and the signal mask for the child.
+    // SAFETY: plain signal-state calls with valid arguments.
+    unsafe {
+        let mut empty: libc::sigset_t = std::mem::zeroed();
+        libc::sigemptyset(&mut empty);
+        if libc::pthread_sigmask(libc::SIG_SETMASK, &empty, std::ptr::null_mut()) != 0
+            || libc::signal(libc::SIGPIPE, libc::SIG_DFL) == libc::SIG_ERR
+        {
+            drop_fail("reset signal state");
+        }
+    }
+
+    let bounding_end = drop_privileges(uid, gid).unwrap_or_else(|e| drop_fail(e));
+    if let Err(e) = verify_privileges(uid, gid, bounding_end) {
+        drop_fail(e);
+    }
+
+    // SAFETY: argv/envp are NULL-terminated arrays of live C strings; FD 3 is the verified
+    // executable. Returns only on failure.
+    unsafe {
+        libc::syscall(
+            libc::SYS_execveat,
+            VMM_FD,
+            c"".as_ptr(),
+            argv_ptrs.as_ptr(),
+            envp.as_ptr(),
+            libc::AT_EMPTY_PATH,
+        );
+    }
+    eprintln!(
+        "jailer: kilnd execveat(3) failed: {}",
+        std::io::Error::last_os_error()
+    );
+    // SAFETY: _exit is always safe.
+    unsafe { libc::_exit(EXIT_EXEC) }
+}
